# SEC asks automated clients to identify themselves with a real contact address.
SEC_USER_AGENT="Your Name your.email@example.com"
ALLOWED_ORIGINS="http://localhost:3000"

# Preferred: one Twelve Data request supplies a year of daily prices for most US
# stocks. Keep secrets server-side; never prefix either key with NEXT_PUBLIC_.
TWELVE_DATA_API_KEY=""

# Optional fallback. Alpha Vantage also supplies company market statistics, but
# its free daily request allowance is much smaller.
ALPHA_VANTAGE_API_KEY=""

# Leave blank to use the frontend's built-in edge API.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
