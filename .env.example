# SEC asks automated clients to identify themselves with a real contact address.
SEC_USER_AGENT="Your Name your.email@example.com"
ALLOWED_ORIGINS="http://localhost:3000"

# Free keys are available from Alpha Vantage. The public demo works without one,
# but the Python API needs this value for live daily prices.
